Dialogue: 0,0:11:52.73,0:11:54.15,画面内容,,0,0,0,,{\frz28.74\pos(640,598)}监制
Dialogue: 0,0:11:52.73,0:11:54.15,画面内容,,0,0,0,,{\pos(1468.667,976.667)}本字幕仅限学习交流\N严禁用于商业用途
Dialogue: 0,0:11:54.31,0:11:55.77,画面内容,,0,0,0,,{\pos(352,396)}蟹堡王
Dialogue: 1,0:11:57.82,0:11:58.94,标准-Chi,,0,0,0,,快点  老妈
Dialogue: 0,0:11:57.82,0:11:58.94,标准-Eng,,0,0,0,,Hurry, Mother
Dialogue: 1,0:11:58.94,0:12:00.24,标准-Chi,,0,0,0,,我都饿死了
Dialogue: 0,0:11:58.94,0:12:00.24,标准-Eng,,0,0,0,,I'm starving
Dialogue: 1,0:12:02.95,0:12:05.16,标准-Chi,,0,0,0,,欢迎回来  海霸王
Dialogue: 0,0:12:02.95,0:12:05.16,标准-Eng,,0,0,0,,Welcome back, Bubble Bass
Dialogue: 1,0:12:05.16,0:12:09.08,标准-Chi,,0,0,0,,距离你上次过来才过了整整一小时呢
Dialogue: 0,0:12:05.16,0:12:09.08,标准-Eng,,0,0,0,,Yeah, it's been an entire hour since your last visit
Dialogue: 1,0:12:09.08,0:12:10.79,标准-Chi,,0,0,0,,那是早餐
Dialogue: 0,0:12:09.08,0:12:10.79,标准-Eng,,0,0,0,,That was breakfast
Dialogue: 1,0:12:11.00,0:12:13.75,标准-Chi,,0,0,0,,这是我的每日乖宝宝奖励
Dialogue: 0,0:12:11.00,0:12:13.75,标准-Eng,,0,0,0,,This is my daily good-boy treat
Dialogue: 1,0:12:13.75,0:12:15.75,标准-Chi,,0,0,0,,对不对啊  老妈
Dialogue: 0,0:12:13.75,0:12:15.75,标准-Eng,,0,0,0,,Isn't it, Mother?
Dialogue: 1,0:12:15.75,0:12:16.79,标准-Chi,,0,0,0,,对啊对啊
Dialogue: 0,0:12:15.75,0:12:16.79,标准-Eng,,0,0,0,,Yeah, yeah
Dialogue: 1,0:12:16.79,0:12:18.50,标准-Chi,,0,0,0,,你是个乖宝宝
Dialogue: 0,0:12:16.79,0:12:18.50,标准-Eng,,0,0,0,,You're a very good boy
Dialogue: 1,0:12:18.50,0:12:19.51,标准-Chi,,0,0,0,,你要吃什么
Dialogue: 0,0:12:18.50,0:12:19.51,标准-Eng,,0,0,0,,Now, what do you want?
Dialogue: 1,0:12:19.88,0:12:21.84,标准-Chi,,0,0,0,,问得好
Dialogue: 0,0:12:19.88,0:12:21.84,标准-Eng,,0,0,0,,I'm so glad you asked
Dialogue: 1,0:12:25.30,0:12:26.72,标准-Chi,,0,0,0,,给我四份双层四分之一磅
Dialogue: 0,0:12:25.30,0:12:26.72,标准-Eng,,0,0,0,,Gimme four double quarter-pound
Dialogue: 1,0:12:26.72,0:12:27.81,标准-Chi,,0,0,0,,蟹黄堡派对套餐
Dialogue: 0,0:12:26.72,0:12:27.81,标准-Eng,,0,0,0,,patty party combos
Dialogue: 1,0:12:27.81,0:12:29.85,标准-Chi,,0,0,0,,三份三层豪华蟹黄堡巨无霸
Dialogue: 0,0:12:27.81,0:12:29.85,标准-Eng,,0,0,0,,three triple deluxe Krabby Patty Supremes
Dialogue: 1,0:12:29.85,0:12:31.14,标准-Chi,,0,0,0,,七层蟹奶昔
Dialogue: 0,0:12:29.85,0:12:31.14,标准-Eng,,0,0,0,,the seven-layer Krusty Shake
Dialogue: 1,0:12:31.14,0:12:32.60,标准-Chi,,0,0,0,,十层蟹蛋糕
Dialogue: 0,0:12:31.14,0:12:32.60,标准-Eng,,0,0,0,,the ten-layer Krusty cake
Dialogue: 1,0:12:32.60,0:12:34.23,标准-Chi,,0,0,0,,三打油炸珊瑚块
Dialogue: 0,0:12:32.60,0:12:34.23,标准-Eng,,0,0,0,,three dozen deep-fried coral bits
Dialogue: 1,0:12:34.23,0:12:35.31,标准-Chi,,0,0,0,,一份无糖海草汽水
Dialogue: 0,0:12:34.23,0:12:35.31,标准-Eng,,0,0,0,,one diet Dr. Kelp
Dialogue: 1,0:12:35.31,0:12:36.48,标准-Chi,,0,0,0,,一份巧克力海草汽水
Dialogue: 0,0:12:35.31,0:12:36.48,标准-Eng,,0,0,0,,one chocolate Dr. Kelp
Dialogue: 1,0:12:36.48,0:12:37.90,标准-Chi,,0,0,0,,十大份满满的辣酱
Dialogue: 0,0:12:36.48,0:12:37.90,标准-Eng,,0,0,0,,ten heaping helpings of the hot chili
Dialogue: 1,0:12:37.90,0:12:39.48,标准-Chi,,0,0,0,,一份蟹黄堡儿童餐
Dialogue: 0,0:12:37.90,0:12:39.48,标准-Eng,,0,0,0,,a Junior Krabby kiddie meal
Dialogue: 1,0:12:39.48,0:12:42.49,标准-Chi,,0,0,0,,少加蛋黄酱
Dialogue: 0,0:12:39.48,0:12:42.49,标准-Eng,,0,0,0,,and easy on the mayo
Dialogue: 1,0:12:43.65,0:12:44.53,标准-Chi,,0,0,0,,就这些吗
Dialogue: 0,0:12:43.65,0:12:44.53,标准-Eng,,0,0,0,,That's all?
Dialogue: 1,0:12:44.53,0:12:45.78,标准-Chi,,0,0,0,,马上就来
Dialogue: 0,0:12:44.53,0:12:45.78,标准-Eng,,0,0,0,,Coming right up
Dialogue: 1,0:12:46.62,0:12:49.03,标准-Chi,,0,0,0,,总共是九百元整
Dialogue: 0,0:12:46.62,0:12:49.03,标准-Eng,,0,0,0,,Your total is 900 even
Dialogue: 1,0:12:49.03,0:12:50.33,标准-Chi,,0,0,0,,老妈来付
Dialogue: 0,0:12:49.03,0:12:50.33,标准-Eng,,0,0,0,,Mother's got it
Dialogue: 1,0:12:50.33,0:12:51.75,标准-Chi,,0,0,0,,谢了  老妈
Dialogue: 0,0:12:50.33,0:12:51.75,标准-Eng,,0,0,0,,Thanks, Mommy
Dialogue: 1,0:12:52.83,0:12:55.29,标准-Chi,,0,0,0,,是付现金还是卖肾
Dialogue: 0,0:12:52.83,0:12:55.29,标准-Eng,,0,0,0,,Will that be cash or kidney?
Dialogue: 1,0:12:55.29,0:12:57.00,标准-Chi,,0,0,0,,海霸王
Dialogue: 0,0:12:55.29,0:12:57.00,标准-Eng,,0,0,0,,Bubble Bass
Dialogue: 1,0:12:58.29,0:13:00.50,标准-Chi,,0,0,0,,你占了我的位子
Dialogue: 0,0:12:58.29,0:13:00.50,标准-Eng,,0,0,0,,You're in my spot
Dialogue: 1,0:13:08.30,0:13:10.56,标准-Chi,,0,0,0,,我早就有三个这种玩具了
Dialogue: 0,0:13:08.30,0:13:10.56,标准-Eng,,0,0,0,,I already have three of these
Dialogue: 1,0:13:10.56,0:13:11.97,标准-Chi,,0,0,0,,给我换个新的
Dialogue: 0,0:13:10.56,0:13:11.97,标准-Eng,,0,0,0,,Get me a new one
Dialogue: 1,0:13:14.10,0:13:15.35,标准-Chi,,0,0,0,,海霸王
Dialogue: 0,0:13:14.10,0:13:15.35,标准-Eng,,0,0,0,,Bubble Bass
Dialogue: 1,0:13:15.35,0:13:19.02,标准-Chi,,0,0,0,,我受够你这种大少爷做派了
Dialogue: 0,0:13:15.35,0:13:19.02,标准-Eng,,0,0,0,,I am sick and tired of your entitled attitude
Dialogue: 1,0:13:19.23,0:13:21.65,标准-Chi,,0,0,0,,你一点都不乖
Dialogue: 0,0:13:19.23,0:13:21.65,标准-Eng,,0,0,0,,You are not being a good boy
Dialogue: 1,0:13:23.36,0:13:24.36,标准-Chi,,0,0,0,,老妈
Dialogue: 0,0:13:23.36,0:13:24.36,标准-Eng,,0,0,0,,Mother?
Dialogue: 1,0:13:24.61,0:13:25.82,标准-Chi,,0,0,0,,从现在起
Dialogue: 0,0:13:24.61,0:13:25.82,标准-Eng,,0,0,0,,From now on
Dialogue: 1,0:13:25.82,0:13:28.57,标准-Chi,,0,0,0,,想吃蟹黄堡的话
Dialogue: 0,0:13:25.82,0:13:28.57,标准-Eng,,0,0,0,,if you want to eat Krabby Patties
Dialogue: 1,0:13:28.57,0:13:31.29,标准-Chi,,0,0,0,,就必须用自己的钱来买
Dialogue: 0,0:13:28.57,0:13:31.29,标准-Eng,,0,0,0,,you'll have to pay for them with your own money
Dialogue: 1,0:13:31.29,0:13:33.91,标准-Chi,,0,0,0,,至于赚钱  就必须去找个
Dialogue: 0,0:13:31.29,0:13:33.91,标准-Eng,,0,0,0,,which you will earn by getting
Dialogue: 1,0:13:34.08,0:13:36.42,标准-Chi,,0,0,0,,工作
Dialogue: 0,0:13:34.08,0:13:36.42,标准-Eng,,0,0,0,,a job
Dialogue: 1,0:13:36.79,0:13:37.71,标准-Chi,,0,0,0,,不要
Dialogue: 0,0:13:36.79,0:13:37.71,标准-Eng,,0,0,0,,No
Dialogue: 1,0:13:38.04,0:13:41.05,标准-Chi,,0,0,0,,我不要工作
Dialogue: 0,0:13:38.04,0:13:41.05,标准-Eng,,0,0,0,,Not a job
Dialogue: 1,0:13:41.55,0:13:46.22,标准-Chi,,0,0,0,,我倒是不介意在这里工作
Dialogue: 0,0:13:41.55,0:13:46.22,标准-Eng,,0,0,0,,Well, I suppose I wouldn't mind working here
Dialogue: 1,0:13:50.01,0:13:51.10,标准-Chi,,0,0,0,,不招聘
Dialogue: 0,0:13:50.01,0:13:51.10,标准-Eng,,0,0,0,,Help not wanted
Dialogue: 1,0:13:51.10,0:13:52.56,标准-Chi,,0,0,0,,不行不行不行
Dialogue: 0,0:13:51.10,0:13:52.56,标准-Eng,,0,0,0,,No, no, no, no, no
Dialogue: 1,0:13:52.72,0:13:55.14,标准-Chi,,0,0,0,,这里只招乖宝宝
Dialogue: 0,0:13:52.72,0:13:55.14,标准-Eng,,0,0,0,,They only hire good boys here
Dialogue: 1,0:13:55.14,0:13:55.85,标准-Chi,,0,0,0,,就像他
Dialogue: 0,0:13:55.14,0:13:55.85,标准-Eng,,0,0,0,,Like him
Dialogue: 1,0:14:00.81,0:14:01.61,标准-Chi,,0,0,0,,走吧
Dialogue: 0,0:14:00.81,0:14:01.61,标准-Eng,,0,0,0,,Let's go
Dialogue: 1,0:14:02.48,0:14:04.44,标准-Chi,,0,0,0,,可是老妈
Dialogue: 0,0:14:02.48,0:14:04.44,标准-Eng,,0,0,0,,But, Mother
Dialogue: 0,0:14:04.44,0:14:06.36,画面内容,,0,0,0,,{\pos(548,696)}海之霸
Dialogue: 0,0:14:06.36,0:14:09.03,画面内容,,0,0,0,,{\pos(814,400)}招聘中
Dialogue: 1,0:14:07.07,0:14:07.99,标准-Chi,,0,0,0,,正好
Dialogue: 0,0:14:07.07,0:14:07.99,标准-Eng,,0,0,0,,Perfect
Dialogue: 1,0:14:07.99,0:14:10.32,标准-Chi,,0,0,0,,海之霸在招人
Dialogue: 0,0:14:07.99,0:14:10.32,标准-Eng,,0,0,0,,The Chum Bucket is hiring
Dialogue: 1,0:14:10.99,0:14:12.70,标准-Chi,,0,0,0,,海之霸吗
Dialogue: 0,0:14:10.99,0:14:12.70,标准-Eng,,0,0,0,,The Chum Bucket?
Dialogue: 1,0:14:13.70,0:14:16.12,标准-Chi,,0,0,0,,不好意思
Dialogue: 0,0:14:13.70,0:14:16.12,标准-Eng,,0,0,0,,Excuse me
Dialogue: 1,0:14:16.71,0:14:19.88,标准-Chi,,0,0,0,,我家儿子要找工作
Dialogue: 0,0:14:16.71,0:14:19.88,标准-Eng,,0,0,0,,My little man here would like a job
Dialogue: 0,0:14:18.12,0:14:19.88,画面内容,,0,0,0,,{\pos(630,262)}招聘中
Dialogue: 1,0:14:21.38,0:14:24.55,标准-Chi,,0,0,0,,谢尔顿  你不面试他吗
Dialogue: 0,0:14:21.38,0:14:24.55,标准-Eng,,0,0,0,,Well, Sheldon, aren't you going to interview him?
Dialogue: 1,0:14:24.76,0:14:25.71,标准-Chi,,0,0,0,,免了
Dialogue: 0,0:14:24.76,0:14:25.71,标准-Eng,,0,0,0,,Pass
Dialogue: 1,0:14:25.92,0:14:28.43,标准-Chi,,0,0,0,,痞老板  我们需要新员工
Dialogue: 0,0:14:25.92,0:14:28.43,标准-Eng,,0,0,0,,Plankton, we need a new employee
Dialogue: 1,0:14:28.43,0:14:31.39,标准-Chi,,0,0,0,,这边各种活都给我干  都累坏我了
Dialogue: 0,0:14:28.43,0:14:31.39,标准-Eng,,0,0,0,,I'm tired of doing all the work around here
Dialogue: 1,0:14:31.39,0:14:33.22,标准-Chi,,0,0,0,,你胡说八道什么
Dialogue: 0,0:14:31.39,0:14:33.22,标准-Eng,,0,0,0,,What are you talking about?
Dialogue: 1,0:14:33.22,0:14:35.06,标准-Chi,,0,0,0,,我也干了不少活啊
Dialogue: 0,0:14:33.22,0:14:35.06,标准-Eng,,0,0,0,,I do plenty of work
Dialogue: 1,0:14:36.14,0:14:38.39,标准-Chi,,0,0,0,,帮我翻个面吧  凯伦
Dialogue: 0,0:14:36.14,0:14:38.39,标准-Eng,,0,0,0,,Flip me over, Karen, would you?
Dialogue: 1,0:14:42.23,0:14:45.73,标准-Chi,,0,0,0,,谢谢你前来面试  海霸王先生
Dialogue: 0,0:14:42.23,0:14:43.52,标准-Eng,,0,0,0,,Thank you for coming
Dialogue: 0,0:14:43.52,0:14:45.73,标准-Eng,,0,0,0,,in for this interview, Mr. Bubble Bass
Dialogue: 1,0:14:46.07,0:14:48.57,标准-Chi,,0,0,0,,你有餐饮业工作经历吗
Dialogue: 0,0:14:46.07,0:14:48.57,标准-Eng,,0,0,0,,Have you ever worked in food service?
Dialogue: 1,0:14:49.99,0:14:50.74,标准-Chi,,0,0,0,,没
Dialogue: 0,0:14:49.99,0:14:50.74,标准-Eng,,0,0,0,,Nope
Dialogue: 1,0:14:50.74,0:14:52.57,标准-Chi,,0,0,0,,他这辈子一天都没工作过
Dialogue: 0,0:14:50.74,0:14:52.57,标准-Eng,,0,0,0,,He's never worked a day in his life
Dialogue: 1,0:14:52.57,0:14:54.20,标准-Chi,,0,0,0,,没有社交技能
Dialogue: 0,0:14:52.57,0:14:54.20,标准-Eng,,0,0,0,,he has no social skills
Dialogue: 1,0:14:54.20,0:14:56.62,标准-Chi,,0,0,0,,卫生简直邋里邋遢
Dialogue: 0,0:14:54.20,0:14:56.62,标准-Eng,,0,0,0,,and his hygiene is offensive at best
Dialogue: 1,0:14:57.16,0:15:00.25,标准-Chi,,0,0,0,,不过他很爱自己的妈妈
Dialogue: 0,0:14:57.16,0:15:00.25,标准-Eng,,0,0,0,,But he loves his mama
Dialogue: 1,0:15:00.25,0:15:01.54,标准-Chi,,0,0,0,,老妈
Dialogue: 0,0:15:00.25,0:15:01.54,标准-Eng,,0,0,0,,Mother
Dialogue: 1,0:15:01.79,0:15:04.55,标准-Chi,,0,0,0,,听起来他可以随时上岗
Dialogue: 0,0:15:01.79,0:15:04.55,标准-Eng,,0,0,0,,Sounds like he has open availability
Dialogue: 1,0:15:04.55,0:15:06.63,标准-Chi,,0,0,0,,而且还有很大的成长空间
Dialogue: 0,0:15:04.55,0:15:06.63,标准-Eng,,0,0,0,,and opportunity for growth
Dialogue: 1,0:15:06.63,0:15:07.67,标准-Chi,,0,0,0,,对吧  痞老板
Dialogue: 0,0:15:06.63,0:15:07.67,标准-Eng,,0,0,0,,Right, Plankton?
Dialogue: 1,0:15:08.80,0:15:09.55,标准-Chi,,0,0,0,,没错
Dialogue: 0,0:15:08.80,0:15:09.55,标准-Eng,,0,0,0,,That's right
Dialogue: 1,0:15:09.55,0:15:12.14,标准-Chi,,0,0,0,,可以让他马上就上岗
Dialogue: 0,0:15:09.55,0:15:12.14,标准-Eng,,0,0,0,,And he can start immediately
Dialogue: 1,0:15:12.14,0:15:13.22,标准-Chi,,0,0,0,,完美
Dialogue: 0,0:15:12.14,0:15:13.22,标准-Eng,,0,0,0,,Perfect
Dialogue: 1,0:15:13.22,0:15:14.72,标准-Chi,,0,0,0,,正是我们需要的
Dialogue: 0,0:15:13.22,0:15:14.72,标准-Eng,,0,0,0,,That's just what we need
Dialogue: 1,0:15:14.72,0:15:16.06,标准-Chi,,0,0,0,,他被录用了
Dialogue: 0,0:15:14.72,0:15:16.06,标准-Eng,,0,0,0,,He's hired
Dialogue: 1,0:15:16.06,0:15:17.81,标准-Chi,,0,0,0,,他接受录用
Dialogue: 0,0:15:16.06,0:15:17.81,标准-Eng,,0,0,0,,He accepts
Dialogue: 1,0:15:20.06,0:15:21.85,标准-Chi,,0,0,0,,要去海滩吗
Dialogue: 0,0:15:20.06,0:15:21.85,标准-Eng,,0,0,0,,Wanna go to the beach?
Dialogue: 1,0:15:22.31,0:15:23.52,标准-Chi,,0,0,0,,当然要啊
Dialogue: 0,0:15:22.31,0:15:23.52,标准-Eng,,0,0,0,,I'd love to
Dialogue: 1,0:15:23.52,0:15:25.19,标准-Chi,,0,0,0,,再见了  两位
Dialogue: 0,0:15:23.52,0:15:25.19,标准-Eng,,0,0,0,,So long, boys
Dialogue: 1,0:15:25.19,0:15:26.98,标准-Chi,,0,0,0,,乖一点哦
Dialogue: 0,0:15:25.19,0:15:26.98,标准-Eng,,0,0,0,,Behave yourselves
Dialogue: 1,0:15:32.61,0:15:35.37,标准-Chi,,0,0,0,,先教你从简单点的做起
Dialogue: 0,0:15:32.61,0:15:35.37,标准-Eng,,0,0,0,,I'll start you off with something simple
Dialogue: 1,0:15:35.37,0:15:37.16,标准-Chi,,0,0,0,,这是海霸缸
Dialogue: 0,0:15:35.37,0:15:37.16,标准-Eng,,0,0,0,,This is the chum vat
Dialogue: 1,0:15:37.37,0:15:41.33,标准-Chi,,0,0,0,,你只要把海霸糊推进挤出机里就行
Dialogue: 0,0:15:37.37,0:15:41.33,标准-Eng,,0,0,0,,All you gotta do is push the chum into the extruder
Dialogue: 1,0:15:46.67,0:15:48.17,标准-Chi,,0,0,0,,觉得自己能行吗
Dialogue: 0,0:15:46.67,0:15:48.17,标准-Eng,,0,0,0,,Think you can handle that?
Dialogue: 1,0:15:48.38,0:15:50.51,标准-Chi,,0,0,0,,赐予我美人鱼战士的超能力
Dialogue: 0,0:15:48.38,0:15:50.51,标准-Eng,,0,0,0,,By the might of Mermaid Man
Dialogue: 1,0:15:50.51,0:15:53.72,标准-Chi,,0,0,0,,我必将攻克这一任务
Dialogue: 0,0:15:50.51,0:15:53.72,标准-Eng,,0,0,0,,I shall vanquish thy task
Dialogue: 1,0:15:54.34,0:15:55.39,标准-Chi,,0,0,0,,随你便
Dialogue: 0,0:15:54.34,0:15:55.39,标准-Eng,,0,0,0,,Whatever
Dialogue: 1,0:16:01.02,0:16:04.86,标准-Chi,,0,0,0,,我会打败你的
Dialogue: 0,0:16:01.02,0:16:04.86,标准-Eng,,0,0,0,,I shall defeat you
Dialogue: 1,0:16:21.87,0:16:22.75,标准-Chi,,0,0,0,,老妈
Dialogue: 0,0:16:21.87,0:16:22.75,标准-Eng,,0,0,0,,Mother?
Dialogue: 1,0:16:24.92,0:16:26.17,标准-Chi,,0,0,0,,这怎么
Dialogue: 0,0:16:24.92,0:16:26.17,标准-Eng,,0,0,0,,What in the
Dialogue: 1,0:16:28.21,0:16:29.59,标准-Chi,,0,0,0,,我的海霸糊
Dialogue: 0,0:16:28.21,0:16:29.59,标准-Eng,,0,0,0,,My chum
Dialogue: 1,0:16:30.09,0:16:31.97,标准-Chi,,0,0,0,,够了  妈宝男
Dialogue: 0,0:16:30.09,0:16:31.97,标准-Eng,,0,0,0,,That's it, mama's boy
Dialogue: 1,0:16:32.22,0:16:34.68,标准-Chi,,0,0,0,,你被开除了
Dialogue: 0,0:16:32.22,0:16:34.68,标准-Eng,,0,0,0,,You are fired
Dialogue: 1,0:16:35.59,0:16:37.85,标准-Chi,,0,0,0,,求你了  痞老板
Dialogue: 0,0:16:35.59,0:16:37.85,标准-Eng,,0,0,0,,Please, Mr. Plankton
Dialogue: 1,0:16:37.85,0:16:39.43,标准-Chi,,0,0,0,,如果我这份工作没了
Dialogue: 0,0:16:37.85,0:16:39.43,标准-Eng,,0,0,0,,If I don't have this job
Dialogue: 1,0:16:39.43,0:16:41.39,标准-Chi,,0,0,0,,就没办法买
Dialogue: 0,0:16:39.43,0:16:41.39,标准-Eng,,0,0,0,,I won't be able to buy
Dialogue: 1,0:16:42.23,0:16:44.94,标准-Chi,,0,0,0,,蟹黄堡了
Dialogue: 0,0:16:42.23,0:16:44.94,标准-Eng,,0,0,0,,Krabby Patties
Dialogue: 1,0:16:46.10,0:16:51.03,标准-Chi,,0,0,0,,等等  蟹堡王竟然允许你买蟹黄堡吗
Dialogue: 0,0:16:46.10,0:16:51.03,标准-Eng,,0,0,0,,Wait, they just let you buy Krabby Patties, huh?
Dialogue: 1,0:16:51.69,0:16:52.32,标准-Chi,,0,0,0,,对啊
Dialogue: 0,0:16:51.69,0:16:52.32,标准-Eng,,0,0,0,,Yes
Dialogue: 1,0:16:52.53,0:16:54.49,标准-Chi,,0,0,0,,我算是个行家
Dialogue: 0,0:16:52.53,0:16:54.49,标准-Eng,,0,0,0,,I'm something of a connoisseur
Dialogue: 1,0:16:54.49,0:16:58.95,标准-Chi,,0,0,0,,我觉得那份复杂却又含蓄的滋味
Dialogue: 0,0:16:54.49,0:16:58.95,标准-Eng,,0,0,0,,You see, I find that the complex yet understated flavor--
Dialogue: 1,0:17:00.37,0:17:01.62,标准-Chi,,0,0,0,,想到了
Dialogue: 0,0:17:00.37,0:17:01.62,标准-Eng,,0,0,0,,Eureka
Dialogue: 1,0:17:01.62,0:17:03.91,标准-Chi,,0,0,0,,我发现你的利用价值了
Dialogue: 0,0:17:01.62,0:17:03.91,标准-Eng,,0,0,0,,I found a use for you
Dialogue: 1,0:17:06.54,0:17:07.58,标准-Chi,,0,0,0,,计划如下
Dialogue: 0,0:17:06.54,0:17:07.58,标准-Eng,,0,0,0,,Here's the plan
Dialogue: 1,0:17:07.92,0:17:11.46,标准-Chi,,0,0,0,,我把你派去蟹堡王买蟹黄堡
Dialogue: 0,0:17:07.92,0:17:11.46,标准-Eng,,0,0,0,,I send you to the Krusty Krab to buy a Krabby Patty
Dialogue: 1,0:17:11.46,0:17:13.01,标准-Chi,,0,0,0,,你吃掉蟹黄堡
Dialogue: 0,0:17:11.46,0:17:13.01,标准-Eng,,0,0,0,,You eat the patty
Dialogue: 1,0:17:13.01,0:17:17.01,标准-Chi,,0,0,0,,同时我躲进你胃里拦截那个蟹黄堡
Dialogue: 0,0:17:13.01,0:17:15.51,标准-Eng,,0,0,0,,Meanwhile, I hide inside your stomach
Dialogue: 0,0:17:15.51,0:17:17.01,标准-Eng,,0,0,0,,to intercept said patty
Dialogue: 1,0:17:17.84,0:17:19.93,标准-Chi,,0,0,0,,然后我就能得到秘密配方
Dialogue: 0,0:17:17.84,0:17:19.93,标准-Eng,,0,0,0,,Then I get the secret formula
Dialogue: 1,0:17:19.93,0:17:21.85,标准-Chi,,0,0,0,,从此卖的蟹黄堡比蟹老板还要多
Dialogue: 0,0:17:19.93,0:17:21.85,标准-Eng,,0,0,0,,I sell more patties than Krabs
Dialogue: 1,0:17:21.85,0:17:24.18,标准-Chi,,0,0,0,,然后我就能统治世界了
Dialogue: 0,0:17:21.85,0:17:24.18,标准-Eng,,0,0,0,,and I take over the world
Dialogue: 1,0:17:24.69,0:17:26.14,标准-Chi,,0,0,0,,真是天才
Dialogue: 0,0:17:24.69,0:17:26.14,标准-Eng,,0,0,0,,It's genius
Dialogue: 1,0:17:29.27,0:17:33.19,标准-Chi,,0,0,0,,我凭什么要帮你  统治世界
Dialogue: 0,0:17:29.27,0:17:33.19,标准-Eng,,0,0,0,,And why should I help you "take over the world"?
Dialogue: 1,0:17:33.19,0:17:35.49,标准-Chi,,0,0,0,,感觉像超级坏蛋才做的事
Dialogue: 0,0:17:33.19,0:17:35.49,标准-Eng,,0,0,0,,That seems rather super-villainous
Dialogue: 1,0:17:36.20,0:17:38.53,标准-Chi,,0,0,0,,秘方一旦到了我手上
Dialogue: 0,0:17:36.20,0:17:38.53,标准-Eng,,0,0,0,,Once I have that formula
Dialogue: 1,0:17:38.53,0:17:41.83,标准-Chi,,0,0,0,,你就再也用不着花钱买蟹黄堡了
Dialogue: 0,0:17:38.53,0:17:41.83,标准-Eng,,0,0,0,,you'll never have to pay for a Krabby Patty again
Dialogue: 1,0:17:42.58,0:17:46.08,标准-Chi,,0,0,0,,那坏蛋队就算我一个
Dialogue: 0,0:17:42.58,0:17:46.08,标准-Eng,,0,0,0,,Then consider me Team Villain
Dialogue: 1,0:17:47.00,0:17:48.50,标准-Chi,,0,0,0,,好了  小不点
Dialogue: 0,0:17:47.00,0:17:48.50,标准-Eng,,0,0,0,,Okay, tiny
Dialogue: 1,0:17:48.50,0:17:49.63,标准-Chi,,0,0,0,,一口吞
Dialogue: 0,0:17:48.50,0:17:49.63,标准-Eng,,0,0,0,,Down the hatch
Dialogue: 1,0:17:50.50,0:17:53.92,标准-Chi,,0,0,0,,要是在里面找到我的旧企鹅男孩手办
Dialogue: 0,0:17:50.50,0:17:53.92,标准-Eng,,0,0,0,,If you see my old Barnacle Boy figurine down there
Dialogue: 1,0:17:53.92,0:17:55.17,标准-Chi,,0,0,0,,就告诉我
Dialogue: 0,0:17:53.92,0:17:55.17,标准-Eng,,0,0,0,,let me know
Dialogue: 1,0:17:57.51,0:17:59.60,标准-Chi,,0,0,0,,我来找你了  老螃蟹
Dialogue: 0,0:17:57.51,0:17:59.60,标准-Eng,,0,0,0,,I'm coming for you, Krabs
Dialogue: 1,0:18:07.89,0:18:09.77,标准-Chi,,0,0,0,,不知道我能不能行
Dialogue: 0,0:18:07.89,0:18:09.77,标准-Eng,,0,0,0,,I don't know if I can do this
Dialogue: 1,0:18:10.02,0:18:11.52,标准-Chi,,0,0,0,,我好紧张
Dialogue: 0,0:18:10.02,0:18:11.52,标准-Eng,,0,0,0,,I'm nervous
Dialogue: 1,0:18:16.07,0:18:17.49,标准-Chi,,0,0,0,,对  看得出来
Dialogue: 0,0:18:16.07,0:18:17.49,标准-Eng,,0,0,0,,Yeah, I can tell
Dialogue: 1,0:18:17.86,0:18:19.36,标准-Chi,,0,0,0,,没事的
Dialogue: 0,0:18:17.86,0:18:19.36,标准-Eng,,0,0,0,,You'll be fine
Dialogue: 1,0:18:19.57,0:18:21.12,标准-Chi,,0,0,0,,表现自然点就行
Dialogue: 0,0:18:19.57,0:18:21.12,标准-Eng,,0,0,0,,Just act natural
Dialogue: 1,0:18:24.70,0:18:25.83,标准-Chi,,0,0,0,,海霸王
Dialogue: 0,0:18:24.70,0:18:25.83,标准-Eng,,0,0,0,,Bubble Bass
Dialogue: 1,0:18:25.83,0:18:27.21,标准-Chi,,0,0,0,,欢迎再次光临
Dialogue: 0,0:18:25.83,0:18:27.21,标准-Eng,,0,0,0,,Welcome back again
Dialogue: 1,0:18:27.21,0:18:29.04,标准-Chi,,0,0,0,,看来这次就你自己来啊
Dialogue: 0,0:18:27.21,0:18:29.04,标准-Eng,,0,0,0,,On your own, I see
Dialogue: 1,0:18:29.04,0:18:32.00,标准-Chi,,0,0,0,,真像个成熟的大男孩啊
Dialogue: 0,0:18:29.04,0:18:32.00,标准-Eng,,0,0,0,,Just like a grownup big boy
Dialogue: 1,0:18:33.42,0:18:34.76,标准-Chi,,0,0,0,,我能来一份
Dialogue: 0,0:18:33.42,0:18:34.76,标准-Eng,,0,0,0,,Can I get one
Dialogue: 1,0:18:35.96,0:18:37.67,标准-Chi,,0,0,0,,蟹黄堡吗
Dialogue: 0,0:18:35.96,0:18:37.67,标准-Eng,,0,0,0,,Krabby Patty?
Dialogue: 1,0:18:38.26,0:18:39.30,标准-Chi,,0,0,0,,就一份吗
Dialogue: 0,0:18:38.26,0:18:39.30,标准-Eng,,0,0,0,,Just one?
Dialogue: 1,0:18:39.59,0:18:40.89,标准-Chi,,0,0,0,,没事吧
Dialogue: 0,0:18:39.59,0:18:40.89,标准-Eng,,0,0,0,,Are you feeling okay?
Dialogue: 1,0:18:40.89,0:18:43.76,标准-Chi,,0,0,0,,对啊  干嘛表现得这么可疑
Dialogue: 0,0:18:40.89,0:18:43.76,标准-Eng,,0,0,0,,Yeah, why are you acting so suspicious?
Dialogue: 1,0:18:44.22,0:18:45.22,标准-Chi,,0,0,0,,我  还可疑
Dialogue: 0,0:18:44.22,0:18:45.22,标准-Eng,,0,0,0,,Me, suspicious?
Dialogue: 1,0:18:45.22,0:18:46.77,标准-Chi,,0,0,0,,你才可疑
Dialogue: 0,0:18:45.22,0:18:46.77,标准-Eng,,0,0,0,,You're suspicious
Dialogue: 1,0:18:46.77,0:18:49.06,标准-Chi,,0,0,0,,我可正常了
Dialogue: 0,0:18:46.77,0:18:49.06,标准-Eng,,0,0,0,,I'm being normal
Dialogue: 1,0:18:49.52,0:18:51.10,标准-Chi,,0,0,0,,我看是挺正常的
Dialogue: 0,0:18:49.52,0:18:51.10,标准-Eng,,0,0,0,,Seems pretty normal to me
Dialogue: 1,0:18:51.10,0:18:52.11,标准-Chi,,0,0,0,,上菜了
Dialogue: 0,0:18:51.10,0:18:52.11,标准-Eng,,0,0,0,,Order up
Dialogue: 1,0:18:54.44,0:18:57.44,标准-Chi,,0,0,0,,我没钱啊
Dialogue: 0,0:18:54.44,0:18:57.44,标准-Eng,,0,0,0,,I don't have any money
Dialogue: 1,0:18:58.36,0:18:59.03,标准-Chi,,0,0,0,,给
Dialogue: 0,0:18:58.36,0:18:59.03,标准-Eng,,0,0,0,,Here
Dialogue: 1,0:19:03.83,0:19:06.24,标准-Chi,,0,0,0,,那我吃了
Dialogue: 0,0:19:03.83,0:19:06.24,标准-Eng,,0,0,0,,Well, here goes
Dialogue: 1,0:19:10.17,0:19:12.63,标准-Chi,,0,0,0,,终于到手了
Dialogue: 0,0:19:10.17,0:19:12.63,标准-Eng,,0,0,0,,Mine at last
Dialogue: 1,0:19:17.30,0:19:18.76,标准-Chi,,0,0,0,,等一下
Dialogue: 0,0:19:17.30,0:19:18.76,标准-Eng,,0,0,0,,Wait a minute
Dialogue: 1,0:19:19.09,0:19:20.80,标准-Chi,,0,0,0,,蟹老板
Dialogue: 0,0:19:19.09,0:19:20.80,标准-Eng,,0,0,0,,Mr. Krabs
Dialogue: 1,0:19:21.30,0:19:22.01,标准-Chi,,0,0,0,,干嘛
Dialogue: 0,0:19:21.30,0:19:22.01,标准-Eng,,0,0,0,,What?
Dialogue: 1,0:19:22.01,0:19:23.64,标准-Chi,,0,0,0,,搞什么鬼
Dialogue: 0,0:19:22.01,0:19:23.64,标准-Eng,,0,0,0,,What's all the hubbubaloo?
Dialogue: 1,0:19:23.64,0:19:26.89,标准-Chi,,0,0,0,,海霸王的肚子在笑
Dialogue: 0,0:19:23.64,0:19:26.89,标准-Eng,,0,0,0,,Bubble Bass' stomach is cackling
Dialogue: 1,0:19:29.35,0:19:31.52,标准-Chi,,0,0,0,,那邪恶的笑声
Dialogue: 0,0:19:29.35,0:19:31.52,标准-Eng,,0,0,0,,That evil laugh
Dialogue: 1,0:19:32.06,0:19:34.31,标准-Chi,,0,0,0,,是痞老板
Dialogue: 0,0:19:32.06,0:19:34.31,标准-Eng,,0,0,0,,It's Plankton
Dialogue: 1,0:19:36.27,0:19:39.70,标准-Chi,,0,0,0,,而且就在海霸王的身体里
Dialogue: 0,0:19:36.27,0:19:39.70,标准-Eng,,0,0,0,,And he's inside Bubble Bass
Dialogue: 1,0:19:40.57,0:19:43.20,标准-Chi,,0,0,0,,执行紧急潜入计划  小子
Dialogue: 0,0:19:40.57,0:19:43.20,标准-Eng,,0,0,0,,Commence emergency dive, boy-o
Dialogue: 1,0:19:44.24,0:19:45.70,标准-Chi,,0,0,0,,我已整装待发  老板
Dialogue: 0,0:19:44.24,0:19:45.70,标准-Eng,,0,0,0,,All suited up, captain
Dialogue: 1,0:19:46.70,0:19:48.37,标准-Chi,,0,0,0,,祝你好运  小子
Dialogue: 0,0:19:46.70,0:19:48.37,标准-Eng,,0,0,0,,Good luck, boy-o
Dialogue: 1,0:19:55.38,0:19:57.50,标准-Chi,,0,0,0,,我要统治世界了
Dialogue: 0,0:19:55.38,0:19:57.50,标准-Eng,,0,0,0,,I'm gonna rule the world
Dialogue: 1,0:19:57.50,0:20:00.09,标准-Chi,,0,0,0,,我要统治世界了
Dialogue: 0,0:19:57.50,0:20:00.09,标准-Eng,,0,0,0,,I'm gonna rule the world
Dialogue: 1,0:20:00.38,0:20:02.05,标准-Chi,,0,0,0,,别急  痞老板
Dialogue: 0,0:20:00.38,0:20:02.05,标准-Eng,,0,0,0,,Not so fast, Plankton
Dialogue: 1,0:20:03.01,0:20:05.60,标准-Chi,,0,0,0,,该去安全出口了
Dialogue: 0,0:20:03.01,0:20:05.60,标准-Eng,,0,0,0,,Time to head for the emergency exit
Dialogue: 0,0:20:06.39,0:20:11.06,画面内容,,0,0,0,,{\pos(1112,144)}肠道
Dialogue: 1,0:20:15.27,0:20:17.82,标准-Chi,,0,0,0,,我能听到他们在穿越大肠
Dialogue: 0,0:20:15.27,0:20:17.82,标准-Eng,,0,0,0,,I can hear 'em going through the large intestine
Dialogue: 1,0:20:22.49,0:20:24.78,标准-Chi,,0,0,0,,现在跑进了他肿胀的脾脏里
Dialogue: 0,0:20:22.49,0:20:24.78,标准-Eng,,0,0,0,,Now they're in his swollen spleen
Dialogue: 1,0:20:27.12,0:20:30.08,标准-Chi,,0,0,0,,现在不知怎么的闯进了他虚弱的心脏
Dialogue: 0,0:20:27.12,0:20:30.08,标准-Eng,,0,0,0,,Somehow, they are now entering his weak heart
Dialogue: 1,0:20:33.08,0:20:35.21,标准-Chi,,0,0,0,,这小子的内脏一团糟
Dialogue: 0,0:20:33.08,0:20:35.21,标准-Eng,,0,0,0,,This boy's insides are a mess
Dialogue: 1,0:20:38.88,0:20:39.92,标准-Chi,,0,0,0,,天啊
Dialogue: 0,0:20:38.88,0:20:39.92,标准-Eng,,0,0,0,,By Jove
Dialogue: 1,0:20:40.88,0:20:42.59,标准-Chi,,0,0,0,,他们跑进他大脑里了
Dialogue: 0,0:20:40.88,0:20:42.59,标准-Eng,,0,0,0,,They're in his brain
Dialogue: 1,0:21:08.28,0:21:09.49,标准-Chi,,0,0,0,,海神王啊
Dialogue: 0,0:21:08.28,0:21:09.49,标准-Eng,,0,0,0,,Good Neptune
Dialogue: 1,0:21:09.79,0:21:11.79,标准-Chi,,0,0,0,,他发癫了
Dialogue: 0,0:21:09.79,0:21:11.79,标准-Eng,,0,0,0,,He's gone loony
Dialogue: 1,0:21:14.83,0:21:15.46,标准-Chi,,0,0,0,,不好
Dialogue: 0,0:21:14.83,0:21:15.46,标准-Eng,,0,0,0,,Oh, no
Dialogue: 1,0:21:15.67,0:21:17.54,标准-Chi,,0,0,0,,他们抵达了我的第二个胃
Dialogue: 0,0:21:15.67,0:21:17.54,标准-Eng,,0,0,0,,They've hit my second stomach
Dialogue: 1,0:21:17.75,0:21:19.75,标准-Chi,,0,0,0,,深渊
Dialogue: 0,0:21:17.75,0:21:19.75,标准-Eng,,0,0,0,,The abyss
Dialogue: 1,0:21:24.42,0:21:26.72,标准-Chi,,0,0,0,,你无路可逃了  痞老板
Dialogue: 0,0:21:24.42,0:21:26.72,标准-Eng,,0,0,0,,End of a line, Plankton
Dialogue: 1,0:21:26.72,0:21:29.97,标准-Chi,,0,0,0,,休想从我手上夺走蟹黄堡  海绵宝宝
Dialogue: 0,0:21:26.72,0:21:29.97,标准-Eng,,0,0,0,,You'll never take this patty from me, SpongeBob
Dialogue: 1,0:21:29.97,0:21:30.72,标准-Chi,,0,0,0,,休想
Dialogue: 0,0:21:29.97,0:21:30.72,标准-Eng,,0,0,0,,Never
Dialogue: 1,0:21:30.72,0:21:33.73,标准-Chi,,0,0,0,,那就只能从蟹黄堡手上夺走你了
Dialogue: 0,0:21:30.72,0:21:33.73,标准-Eng,,0,0,0,,Then I guess I'll have to take you from the patty
Dialogue: 1,0:21:36.14,0:21:37.06,标准-Chi,,0,0,0,,等一下
Dialogue: 0,0:21:36.14,0:21:37.06,标准-Eng,,0,0,0,,Wait a minute
Dialogue: 1,0:21:44.36,0:21:45.65,标准-Chi,,0,0,0,,好吃
Dialogue: 0,0:21:44.36,0:21:45.65,标准-Eng,,0,0,0,,Delicious
Dialogue: 1,0:21:46.40,0:21:47.32,标准-Chi,,0,0,0,,等等
Dialogue: 0,0:21:46.40,0:21:47.32,标准-Eng,,0,0,0,,Wait
Dialogue: 1,0:21:47.32,0:21:49.07,标准-Chi,,0,0,0,,感觉哪里不对劲
Dialogue: 0,0:21:47.32,0:21:49.07,标准-Eng,,0,0,0,,Something's not right
Dialogue: 1,0:21:52.91,0:21:56.21,标准-Chi,,0,0,0,,让蟹黄堡远离痞老板的魔爪没  小子
Dialogue: 0,0:21:52.91,0:21:56.21,标准-Eng,,0,0,0,,Did you get the Krabby Patty away from Plankton, boy-o?
Dialogue: 1,0:21:56.41,0:21:58.17,标准-Chi,,0,0,0,,不如这么说吧
Dialogue: 0,0:21:56.41,0:21:58.17,标准-Eng,,0,0,0,,In a manner of speaking
Dialogue: 1,0:22:03.09,0:22:06.17,标准-Chi,,0,0,0,,我今天不吃蟹黄堡了
Dialogue: 0,0:22:03.09,0:22:06.17,标准-Eng,,0,0,0,,Welp, no more patties for me today
Dialogue: 1,0:22:06.17,0:22:08.76,标准-Chi,,0,0,0,,也不工作了
Dialogue: 0,0:22:06.17,0:22:08.76,标准-Eng,,0,0,0,,And also, no more work
Dialogue: 1,0:22:09.09,0:22:10.43,标准-Chi,,0,0,0,,我辞职
Dialogue: 0,0:22:09.09,0:22:10.43,标准-Eng,,0,0,0,,I quit
Dialogue: 1,0:22:15.31,0:22:16.81,标准-Chi,,0,0,0,,笑什么
Dialogue: 0,0:22:15.31,0:22:16.81,标准-Eng,,0,0,0,,What's so funny?
Dialogue: 1,0:22:16.81,0:22:17.69,标准-Chi,,0,0,0,,没什么
Dialogue: 0,0:22:16.81,0:22:17.69,标准-Eng,,0,0,0,,Nothin'
Dialogue: 1,0:22:18.19,0:22:19.44,标准-Chi,,0,0,0,,痞老板搞得我好痒
Dialogue: 0,0:22:18.19,0:22:19.44,标准-Eng,,0,0,0,,Plankton just tickles
Dialogue: 1,0:22:19.98,0:22:21.36,标准-Chi,,0,0,0,,放我出去
Dialogue: 0,0:22:19.98,0:22:21.36,标准-Eng,,0,0,0,,Let me out
Dialogue: 1,0:22:21.90,0:22:22.94,标准-Chi,,0,0,0,,失陪一下
Dialogue: 0,0:22:21.90,0:22:22.94,标准-Eng,,0,0,0,,If you don't mind
Dialogue: 1,0:22:22.94,0:22:24.99,标准-Chi,,0,0,0,,我现在要去上厕所了
Dialogue: 0,0:22:22.94,0:22:24.99,标准-Eng,,0,0,0,,I'll be taking my bathroom break now
Dialogue: 1,0:22:27.86,0:22:29.70,标准-Chi,,0,0,0,,我需要找个新工作
Dialogue: 0,0:22:27.86,0:22:29.70,标准-Eng,,0,0,0,,I need a new job
